{
  "name": "Автострелки",
  "icon": "littlelogistics:automatic_switch_rail",
  "category": "littlelogistics:blocks",
  "pages": [
    {
      "type": "patchouli:text",
      "text": "Такие стрелки переключаются автоматически при приближении локомотива. Направление выбирается по ближайшему непосещённому в текущем круге пункту из $(l:loco_route)маршрута локомотива$()."
    },
    {
      "type": "patchouli:crafting",
      "title": "Автострелка",
      "recipe": "littlelogistics:automatic_switch_rail",
      "text": "Переключает прямо или влево/вправо."
    },
    {
      "type": "patchouli:crafting",
      "title": "Автострелка T-развилка",
      "recipe": "littlelogistics:automatic_tee_junction_rail",
      "text": "Переключает влево/вправо."
    }
  ]
}