  "zume.options.zoom_speed.name": "Зум Скорость",
  "zume.options.zoom_speed.tooltip": "Скорость для привязок клавиш приближения/отдаления и прокрутки зума (если включена).\nПО УМОЛЧАНИЮ: 20",
  "zume.options.enable_zoom_scrolling.name": "Включить Зум Прокрутка",
  "zume.options.enable_zoom_scrolling.tooltip": "Позволяет приближать и отдалять прокруткой вверх и вниз на мыши, пока зум активен.\nЭто помешает вам прокручивать панель быстрого доступа во время зумирования, если включено.\nПО УМОЛЧАНИЮ: Включено",
  "zume.options.enable_cinematic_zoom.name": "Включить Кинематографическая Зум",
  "zume.options.enable_cinematic_zoom.tooltip": "Включить Кинематографическая Камеру пока зум.\nПО УМОЛЧАНИЮ: Включено",
  "zume.options.mouse_sensitivity_floor.name": "Мыши Чувствительность Минимум",
  "zume.options.mouse_sensitivity_floor.tooltip": "Чувствительность мыши не будет снижена ниже этого значения при приближении.\nПО УМОЛЧАНИЮ: 40%",
  "zume.options.default_zoom.name": "По умолчанию Зум",
  "zume.options.default_zoom.tooltip": "По умолчанию стартовый зум процент.\nПО УМОЛЧАНИЮ: 50%",
  "zume.options.first_person_toggle_mode.name": "От первого лица Переключение Режим",
  "zume.options.first_person_toggle_mode.tooltip": "If включено, the Зум keybind будет act как a переключение in от первого лица.\nIf отключено, Зум будет только be активен in от первого лица пока the keybind is в руке.\nПО УМОЛЧАНИЮ: Отключено",
  "zume.options.third_person_toggle_mode.name": "От третьего лица Переключение Режим",
  "zume.options.third_person_toggle_mode.tooltip": "If включено, the Зум keybind будет act как a переключение in от третьего лица.\nIf отключено, Зум будет только be активен in от третьего лица пока the keybind is в руке.\nПО УМОЛЧАНИЮ: Включено",
  "zume.options.zoom_smoothness_ms.name": "Зум Плавность",
  "zume.options.zoom_smoothness_ms.tooltip": "ПОЛЕ ЗРЕНИЯ изменения будет be распределены out за этот многие миллисекунд.\nПО УМОЛЧАНИЮ: 150ms",
  "zume.options.max_third_person_zoom_blocks.name": "Максимум От третьего лица Зум Дистанция",
  "zume.options.max_third_person_zoom_blocks.tooltip": "Максимум от третьего лица зум дистанция (in блоков).\nПО УМОЛЧАНИЮ: 15 блоков",
  "zume.options.min_third_person_zoom_blocks.name": "Минимальное От третьего лица Зум Дистанция",
  "zume.options.min_third_person_zoom_blocks.tooltip": "Минимальное от третьего лица зум дистанция (in блоков).\nУстановить to 4 блоков to mimic vanilla.\nПО УМОЛЧАНИЮ: 0.5 блоков",
  "zume.options.animation_easing_exponent.name": "Анимации Сглаживания Показатель",
  "zume.options.animation_easing_exponent.tooltip": "The показатель используется for сглаживания animations.\nПО УМОЛЧАНИЮ: Quartic",
  "zume.options.zoom_easing_exponent.name": "Зум Нормализации Показатель",
  "zume.options.zoom_easing_exponent.tooltip": "The показатель используется for making различия in ПОЛЕ ЗРЕНИЯ более равномерными.\nПО УМОЛЧАНИЮ: Quadratic",
  "zume.options.min_fov.name": "Минимальное ПОЛЕ ЗРЕНИЯ",
  "zume.options.min_fov.tooltip": "Минимальное зум ПОЛЕ ЗРЕНИЯ.\nПО УМОЛЧАНИЮ: 1.0",
  "zume.options.disable.name": "Отключить",
  "zume.options.disable.tooltip": "If включено, the mod будет be отключено (на some платформы, ключ привязки будет still показать in игра настройки; they won't do anything if этот is установить to включено).\nТребуется re-launch to дубль эффект.\nПО УМОЛЧАНИЮ: Отключено"
}
